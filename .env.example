# ============================================================
# Modelo dos secrets das Edge Functions (Supabase).
# Copie para .env.secrets, preencha os valores REAIS e rode:
#     supabase secrets set --env-file .env.secrets
#     supabase secrets list
# .env.secrets NUNCA vai para o Git (ver .gitignore).
#
# Regras de sintaxe (o arquivo é lido linha a linha):
#   - uma variável por linha, CHAVE=valor
#   - sem espaço antes ou depois do "="
#   - sem "\" no fim da linha (isso é sintaxe de shell, não de .env)
#   - sem aspas, a menos que o valor tenha espaço
#   - nada de chaves repetidas
#
# NÃO defina SUPABASE_URL, SUPABASE_ANON_KEY nem
# SUPABASE_SERVICE_ROLE_KEY aqui: o Supabase injeta essas três
# automaticamente em toda function e recusa o prefixo SUPABASE_.
# ============================================================

# ---------- Mercado Pago ----------
# test = usa MP_ACCESS_TOKEN_TEST (sandbox). prod = usa MP_ACCESS_TOKEN_PROD.
MP_MODE=test
# Credenciais > Credenciais de produção > Access token (começa com APP_USR-)
MP_ACCESS_TOKEN_PROD=
# Credenciais > Credenciais de teste > Access token (começa com TEST-)
# ATENÇÃO: não é o "user_id" do usuário de teste (aquele número tipo 315930).
MP_ACCESS_TOKEN_TEST=
MP_NOTIFICATION_URL=https://ejarqinmjlgbqzurctsf.supabase.co/functions/v1/mp-webhook
MP_RETURN_URL_BASE=https://ervatorio.com.br
# Suas integrações > (app) > Webhooks > "Assinatura secreta"
MP_WEBHOOK_SECRET=
# true = rejeita webhook sem assinatura válida. Ver WEBHOOK_SIGNATURE_DEBT.md.
MP_WEBHOOK_STRICT=false

# ---------- App ----------
ALLOWED_ORIGIN=https://ervatorio.com.br
GUEST_CHECKOUT=true
SHIPPING_ENABLED=false

# ---------- E-mail (Resend) ----------
# resend.com > API Keys (começa com re_)
RESEND_API_KEY=
# Com nome amigável precisa de aspas por causa dos < >:
EMAIL_FROM="Ervatorio <onboarding@resend.dev>"
EMAIL_BCC=fsannino@gmail.com
